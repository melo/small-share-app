# Copy to .env and edit. `.env` is gitignored; never commit a real auth key.
#
#     cp .env.example .env
#     docker compose up -d

# ---------------------------------------------------------------- tailscale --

# REQUIRED for docker-compose.yml (not for docker-compose.local.yml).
#
# Generate at: https://login.tailscale.com/admin/settings/keys
#   * "Reusable" if you will redeploy this stack more than once
#   * "Ephemeral" OFF — an ephemeral node disappears when the container stops,
#     taking its certificate and its MagicDNS name with it
#   * Tag it if your ACLs use tags
#
# The key is only used to register the node. Once registered, the node keeps
# working after the key expires; the state in the tailscale-state volume is what
# matters from then on.
TS_AUTHKEY=tskey-auth-replace-me

# The node name on your tailnet, and therefore the hostname:
#   https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=share

# ---------------------------------------------------------------------- app --

# Optional. Every URL handed to an agent is built from this. Leave it unset and
# the app derives it from the request, which is correct behind `tailscale
# serve`. Set it if you would rather the URL never depend on a header.
#SHARE_BASE_URL=https://share.your-tailnet.ts.net

# Where the SQLite database and the stored files live, on the host.
SHARE_DATA=./data

# Delete files this many days after upload. Also the ceiling: an upload may ask
# for less, never more.
SHARE_TTL_DAYS=15

# Per-file limit, in bytes. 32 MB.
SHARE_MAX_BYTES=33554432

# Ceiling on EVERYTHING held at once, in bytes. 50 GB.
#
# Enforced by eviction, not refusal: when an upload pushes the total over this,
# the oldest files are deleted until it fits again, whatever their expiry says.
# A public box that fills its disk goes down, which is a worse outcome than
# losing the oldest thing on it. Set 0 to disable and trust SHARE_TTL_DAYS
# alone — reasonable on a private box with a disk you watch.
#SHARE_MAX_TOTAL_BYTES=53687091200

# Upload attempts allowed per client. Attempts, not successes: a rejected file
# still uses a slot, so hammering the endpoint with junk does not get a free
# pass. The pair matters — per-second stops a fast loop instantly, per-minute
# stops a patient one. Either can be 0 to disable.
#SHARE_RATE_PER_SECOND=1
#SHARE_RATE_PER_MINUTE=10

# Let /api/v1/health report how many files are held and how many bytes. OFF by
# default and it should stay off anywhere a stranger can reach: it is inventory,
# and watched for a few minutes it tells someone whether their upload is still
# there. Turn it on for a private deployment whose collector needs the numbers.
#SHARE_HEALTH_DETAIL=1

# ------------------------------------------------------------- chat rooms --
#
# Rooms are the other half of this service: agents in different sessions talk to
# each other in one, and a person can open the same URL and take part. They live
# in the same database and expire on the same clock as files — SHARE_TTL_DAYS.

# The biggest one message may be, in bytes. 16 KB, which is a long paragraph or
# a stack trace worth quoting. Anything larger is a file: share it and post the
# URL, which is what the rooms tell agents to do.
#SHARE_CHAT_MAX_MESSAGE_BYTES=16384

# How much history one room keeps. Past it the oldest messages go, and a caller
# reading from a message that has been dropped is told it missed some. 0 keeps
# everything until the room expires.
#SHARE_CHAT_MAX_MESSAGES=5000

# Posting and room-opening attempts allowed per caller. Counted separately from
# uploads, so a busy room never uses up somebody's file uploads and vice versa.
# Either can be 0 to disable.
#SHARE_CHAT_RATE_PER_SECOND=5
#SHARE_CHAT_RATE_PER_MINUTE=60

# Require every upload to carry a signed ticket from the MCP get_upload_url
# tool. Off, because plain `curl --data-binary @f.md '...?filename=f.md'` is the
# documented path and should work out of the box.
#SHARE_REQUIRE_SIGNED_UPLOADS=1

# HMAC key for those signed upload URLs. Generated into the data directory as
# share.key on first start and kept there, so leave this unset unless you would
# rather manage the key yourself.
#SHARE_SECRET_KEY=

# One line of deployment truth the app cannot know: who can reach this, and who
# to ask for access. Shown on the home page and handed to every agent in the MCP
# instructions. Leave empty if you have nothing to say.
SHARE_NOTICE=Reachable on this tailnet only — a link sent outside it will not open.

# The uid/gid the container runs as, so the files it writes into SHARE_DATA
# belong to a real account on the host. `id -u` and `id -g`.
SHARE_UID=1000
SHARE_GID=1000

# Which image to run. The default is the published one; `docker compose build`
# overrides it with your own.
#SHARE_IMAGE=ghcr.io/melo/small-share-app:latest

# ------------------------------------------------- the other compose files --
#
# Only read by the stack named beside each one; harmless to leave set.

# docker-compose.local.yml — host port published on 127.0.0.1.
#SHARE_PORT=8080

# docker-compose.tsdproxy.yml — host port tsdproxy reaches the app on.
#SHARE_LOOPBACK_PORT=3310

# docker-compose.traefik.yml — REQUIRED there: the hostname Traefik routes.
# The router and entrypoint names only need changing if they collide with
# something else already on your Traefik.
#SHARE_HOST=share.example.com
#TRAEFIK_ROUTER=share
#TRAEFIK_ENTRYPOINT=websecure
